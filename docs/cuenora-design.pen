            },
            {
              "type": "text",
              "id": "ec09H",
              "name": "Review, then confirm explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Account creation, income/expense and transfer forms lead to review before a final confirmation. The review repeats dates, currencies, accounts and recorded effects. Cancel changes nothing; success returns to the originating context.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "su7Pu",
          "name": "Select eligible accounts",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "tG3Kx",
              "name": "Select eligible accounts heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Select eligible accounts",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "x9Q4sq",
              "name": "Select eligible accounts explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Income can use a normal account or no account. Ordinary income cannot be assigned to savings, including edits. Savings contributions use transfers; actual credited interest has its separate P01.08 flow. Assigned income/expense currency must match its account.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "k8MxX",
          "name": "One transfer, two amounts",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "k0LMij",
              "name": "One transfer, two amounts heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "One transfer, two amounts",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "S4QN8R",
              "name": "One transfer, two amounts explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "From and To must be distinct owned accounts. Same-currency amounts match. Across currencies, sent and received amounts are required; the reference rate is optional and cannot silently replace them. History shows one operation; its detail shows both movements.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "G2pyf",
          "name": "Account and transaction boundaries",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "rMwWZ",
              "name": "Account and transaction boundaries heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Account and transaction boundaries",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fMZr0",
              "name": "Account and transaction boundaries explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Account activity includes opening movements; Transactions lists business operations. Openings and transfers are excluded from income/spending. Pending payments remain separate. Savings opens the same underlying account, not a second balance store.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "exHnL",
          "name": "Filter and return context",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "r8XvaK",
              "name": "Filter and return context heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Filter and return context",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fK1Yu",
              "name": "Filter and return context explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The shown October range is illustrative, not a default. Account choices include All, a specific account, and No account assigned. Filters are provisional controls; cancel keeps the applied filters. Details and successful edits return to the original list context.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "oDqgE",
          "name": "Correction and recovery",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "TDCT6",
              "name": "Correction and recovery heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Correction and recovery",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "KbAN1",
              "name": "Correction and recovery explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Edit the existing record and preserve its audit history. Reassignment reverses the old account effect and applies the new one together. Do not expose deletion of posted movements as routine cleanup. No new financial operation is created when a result is uncertain.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "RwUC1",
          "name": "Scope boundary",
          "fill": "#202020",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Low-fidelity sketches only. Navigation and form presentation are provisional. P01.08 owns dedicated Recurrence, Savings and Insights screens; P01.09–P01.10 own visual styling and the wider state/component system.",
          "lineHeight": 1.4,
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
