        },
        {
          "type": "text",
          "id": "jlD9G",
          "name": "Adaptive implementation checklist",
          "fill": "$p0110-light-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "IMPLEMENTATION CHECKLIST\n• Grow controls with text; minimum targets are not fixed heights.\n• Preserve full amounts, signs, currencies, dates and error messages. Never shrink type or silently ellipsize a critical value.\n• Use layout alternatives, not clipped navigation labels; test actual maximum supported amounts and localized formats.\n• Keep focus visible, dialogs escapable and status announcements appropriate.\n• Respect platform text settings, contrast settings and reduced motion.",
          "lineHeight": 1.5,
          "fontFamily": "$p0110-font-ui",
          "fontSize": "$p0110-type-body",
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Vetr4",
          "name": "Adaptive scope boundary",
          "fill": "$p0110-light-text-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The initial design system is defined here. Native viewport behavior, screen readers, keyboard traversal, reduced motion and complete light/dark implementation remain work for the actual clients; no production code is changed.",
          "lineHeight": 1.5,
          "fontFamily": "$p0110-font-ui",
          "fontSize": "$p0110-type-meta",
          "fontWeight": "normal"
        }
      ]
    }
