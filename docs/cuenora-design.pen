    {
      "type": "frame",
      "id": "g1AOk",
      "x": 2880,
      "y": 0,
      "name": "P01.06 · Home · Design notes and interactions",
      "width": 620,
      "fill": "#F6F6F6",
      "layout": "vertical",
      "gap": 24,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "cWEtI",
          "name": "Roadmap label",
          "fill": "#202020",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "CUENORA  /  P01.06",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "WViyC",
          "name": "Design notes title",
          "fill": "#202020",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Home, before visual styling",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 32,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "BcGId",
          "name": "Wireframe intent",
          "fill": "#202020",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Where is my money, and which account needs attention? A low-fidelity mobile sketch grounded in P01.05 and the product acceptance examples.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "DpOqR",
          "name": "01 · Read recorded money first",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "PBS60",
              "name": "01 · Read recorded money first heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "01 · Read recorded money first",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "HnIO9",
              "name": "01 · Read recorded money first explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "SEK, EUR and USD remain separate. Savings balances, when present, are already part of their currency total. No conversion, available-to-spend claim or forecast interest is included.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "YZ8Ru",
          "name": "02 · Plan for a selected date",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "z1VR2",
              "name": "02 · Plan for a selected date heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "02 · Plan for a selected date",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "zURFp",
              "name": "02 · Plan for a selected date explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "30 October 2026 is an explicit example selection, not a default policy. The date control opens a date picker; returning keeps that selection. Detailed date boundaries remain P09.01 work.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "hjbTY",
          "name": "03 · Keep the source account visible",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "pMMxk",
              "name": "03 · Keep the source account visible heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "03 · Keep the source account visible",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "TBBvd",
              "name": "03 · Keep the source account visible explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "EX-08: A = SEK 300; B = SEK 2,000; one SEK 800 pending payment from A. A’s planning difference is −SEK 500. B’s balance does not remove A’s shortfall. The main sketch adds independent EUR/USD fixtures.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "A1Bo4",
          "name": "04 · Review before recording a payment",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "xCyIR",
              "name": "04 · Review before recording a payment heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "04 · Review before recording a payment",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "g7DZHX",
              "name": "04 · Review before recording a payment explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A payment row opens occurrence details. Review is read-only. Confirmation happens there, only after the user paid. No due date, tap on Home or planning difference posts money.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "q7gij",
          "name": "05 · Preserve accountless paths",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "mislt",
              "name": "05 · Preserve accountless paths heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "05 · Preserve accountless paths",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "SpJ8y",
              "name": "05 · Preserve accountless paths explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The EUR 20 example remains “No account assigned” and is outside every account’s planning difference. Open its details to assign an account or leave it unassigned. First use allows income/expense recording without an account.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "bCkQZ",
          "name": "06 · Keep navigation shallow",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "uLK5j",
              "name": "06 · Keep navigation shallow heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "06 · Keep navigation shallow",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "ykCsR",
              "name": "06 · Keep navigation shallow explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Four provisional tabs: Home, Accounts, Transactions, Insights. “View recurrence” and “View savings” are explicit Home links. Settings includes session controls. Detail returns preserve context.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "PXoLz",
          "name": "07 · Show the whole scroll, not a giant phone",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "Y7io9",
              "name": "07 · Show the whole scroll, not a giant phone heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "07 · Show the whole scroll, not a giant phone",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "d8qCX",
              "name": "07 · Show the whole scroll, not a giant phone explanation",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The populated Home is a full scroll-content specimen at 390 px width. In implementation, system chrome and tabs stay outside the scrolling body. The header + opens the activity menu shown below.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "t0JxX",
          "name": "08 · States are data, not decoration",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "SGGUC",
              "name": "08 · States are data, not decoration heading",
              "fill": "#202020",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "08 · States are data, not decoration",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
