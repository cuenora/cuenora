# Local development only. Copy to .env without overwriting an existing file.
# Set a private password before starting a NEW database; keep the same password
# when reusing an existing volume. Never commit .env or real credentials.
CUENORA_POSTGRES_PASSWORD=

# Host port; Compose binds only to 127.0.0.1. Change if 5432 is already in use.
CUENORA_POSTGRES_PORT=5432

# The API does NOT load .env. Export CUENORA_DATABASE_URL explicitly to enable
# registration against a synthetic local database with migrations 0001–0008.
# Percent-encode password URL characters; never commit a populated URL.
# CUENORA_DATABASE_URL=postgres://cuenora:<percent-encoded-password>@127.0.0.1:5432/cuenora
