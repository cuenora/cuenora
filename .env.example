# Local development only. Copy to .env without overwriting an existing file.
# Set a private password before starting a NEW database; keep the same password
# when reusing an existing volume. Never commit .env or real credentials.
CUENORA_POSTGRES_PASSWORD=

# Host port; Compose binds only to 127.0.0.1. Change if 5432 is already in use.
CUENORA_POSTGRES_PORT=5432

# The API does NOT load .env. Export CUENORA_DATABASE_URL explicitly to enable
# database-backed operations against a synthetic local database with all migrations.
# Percent-encode password URL characters; never commit a populated URL.
# CUENORA_DATABASE_URL=postgres://cuenora:<percent-encoded-password>@127.0.0.1:5432/cuenora

# API/runtime variables: export them, or pass with Docker --env-file explicitly.
# The binaries never read .env themselves. Defaults below preserve local behavior.
CUENORA_LISTEN_ADDR=127.0.0.1:3000
# In Docker use CUENORA_LISTEN_ADDR=0.0.0.0:3000 and publish a loopback host port.
# Public documentation target, NOT the bind address; no credentials/query/fragment.
# Render with cuenora-openapi; the checked-in contract remains local-development.
CUENORA_PUBLIC_API_URL=http://127.0.0.1:3000

# Positive integer seconds; access 60..3600, refresh 3600..7776000 (90 days).
# Refresh must exceed access. Changes apply to newly issued tokens only.
CUENORA_ACCESS_TOKEN_TTL_SECONDS=900
CUENORA_REFRESH_TOKEN_TTL_SECONDS=2592000

# Pool capacity 1..100; timeouts 1..60000 milliseconds, lock <= statement.
CUENORA_DB_MAX_CONNECTIONS=4
CUENORA_DB_ACQUIRE_TIMEOUT_MS=3000
CUENORA_DB_STATEMENT_TIMEOUT_MS=5000
CUENORA_DB_LOCK_TIMEOUT_MS=2000

# Optional trusted immediate proxy IPs (comma-separated, max 32); unset by default.
# Enable only behind a configured trusted proxy that supplies CF-Connecting-IP.
# CUENORA_TRUSTED_PROXY_IPS=127.0.0.1

# Optional paired settings: set BOTH to enable verification email requests.
# No default sender/API key. Never commit a populated key or print it to logs.
# Sender is a bare address on a Resend-verified sending domain (no display name).
# Use a least-privilege sending key; disable open/click tracking for auth mail.
# CUENORA_RESEND_API_KEY=re_<private-sending-key>
# CUENORA_EMAIL_FROM=verify@your-verified-domain.example
