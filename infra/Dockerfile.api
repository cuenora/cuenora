FROM rust:1.99.1-bookworm AS builder

WORKDIR /build
COPY backend ./backend
COPY contracts ./contracts

RUN cargo build --locked --release \
    --manifest-path backend/Cargo.toml \
    -p cuenora-api \
    --bin cuenora-api \
    --bin cuenora-openapi \
    --bin cuenora-healthcheck \
    --bin cuenora-recurrence-job

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/backend/target/release/cuenora-api /usr/local/bin/cuenora-api
COPY --from=builder /build/backend/target/release/cuenora-openapi /usr/local/bin/cuenora-openapi

COPY --from=builder /build/backend/target/release/cuenora-healthcheck /usr/local/bin/cuenora-healthcheck
COPY --from=builder /build/backend/target/release/cuenora-recurrence-job /usr/local/bin/cuenora-recurrence-job

USER 65532:65532
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["cuenora-healthcheck"]

ENTRYPOINT ["cuenora-api"]
